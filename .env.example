# Public HTTPS address (Telegram requires HTTPS for webhooks and Mini Apps).
# For local runs use a tunnel, e.g. `cloudflared tunnel --url http://localhost:8080`
PUBLIC_URL=https://your-domain.example
HTTP_PORT=8080

BOT_TOKEN=
# Comma-separated Telegram user ids allowed to add products
ADMIN_IDS=
# Only A-Z, a-z, 0-9, _ and - are allowed: openssl rand -hex 32
WEBHOOK_SECRET=
# Shared secret between the bot and the backend: openssl rand -hex 32
INTERNAL_API_TOKEN=

POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
S3_BUCKET=products

BACKEND_REPLICAS=2
BOT_REPLICAS=2
FRONTEND_REPLICAS=2
